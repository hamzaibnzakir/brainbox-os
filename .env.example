BRAINBOX_ENV=development
BRAINBOX_LLM_PROVIDER=openai
BRAINBOX_LLM_MODEL=gpt-5.6-luna
OPENAI_API_KEY=
BRAINBOX_STT_BACKEND=faster_whisper
BRAINBOX_WHISPER_MODEL=base.en
BRAINBOX_WHISPER_DEVICE=cpu
BRAINBOX_WHISPER_COMPUTE=int8
# Optional whisper.cpp backend:
# BRAINBOX_STT_BACKEND=whisper_cpp
# BRAINBOX_WHISPER_CPP_BIN=C:\\path\\to\\whisper-cli.exe
# BRAINBOX_WHISPER_CPP_MODEL=C:\\path\\to\\ggml-base.en.bin
# BRAINBOX_WHISPER_CPP_GPU=1

# Always-on local wake word
BRAINBOX_WAKEWORD_MODEL=models/wakeword/hey_brainbox.onnx
BRAINBOX_WAKEWORD_BACKEND=openwakeword
BRAINBOX_WAKEWORD_THRESHOLD=0.85
BRAINBOX_SHERPA_WAKEWORD_MODEL=models/wakeword/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01
BRAINBOX_SHERPA_KEYWORDS=models/wakeword/sherpa-onnx-kws-zipformer-gigaspeech-3.3M-2024-01-01/brainbox_keywords.txt

# Wake word hardening
BRAINBOX_WAKEWORD_VAD_THRESHOLD=0.50
# Optional: train this on your own voice before enabling it
# BRAINBOX_WAKEWORD_VERIFIER=models/wakeword/hey_brainbox_verifier.pkl
BRAINBOX_WAKEWORD_VERIFIER_THRESHOLD=0.30

# Agent execution policy. READ/PREPARE/WRITE/EXTERNAL are enabled by default for the owner's autonomous OS.
# DESTRUCTIVE is disabled by default.
BRAINBOX_AGENT_ALLOW_READ=true
BRAINBOX_AGENT_ALLOW_PREPARE=true
BRAINBOX_AGENT_ALLOW_WRITE=true
BRAINBOX_AGENT_ALLOW_EXTERNAL=true
BRAINBOX_AGENT_ALLOW_DESTRUCTIVE=false

# Low-latency local speech through Windows System.Speech / SAPI.
# Rate is -10..10, with 0 as the Windows default. 1 is a slightly faster conversational pace.
BRAINBOX_TTS_BACKEND=windows-sapi
BRAINBOX_TTS_RATE=1
BRAINBOX_TTS_VOLUME=100
# Optional exact or partial installed voice name. Leave empty to use the Windows default voice.
BRAINBOX_TTS_VOICE=
BRAINBOX_TTS_RATE_PYTTSX=215

# Speech recognition: set to parakeet to use the JezFlow-inspired local Parakeet TDT path
BRAINBOX_STT_BACKEND=faster_whisper
BRAINBOX_PARAKEET_MODEL_DIR=models/stt/sherpa-onnx-nemo-parakeet-tdt-0.6b-v2-int8
BRAINBOX_PARAKEET_PROVIDER=cpu
BRAINBOX_PARAKEET_THREADS=4
BRAINBOX_PARAKEET_DECODING=modified_beam_search
BRAINBOX_PARAKEET_HOTWORDS_FILE=
BRAINBOX_PARAKEET_HOTWORDS_SCORE=1.5
BRAINBOX_PARAKEET_BPE_VOCAB=
# Explicit ASR corrections, e.g. "Brainbox: Brain Box, Brain bucks; Shopify: Shop if I"
BRAINBOX_STT_DICTIONARY=
